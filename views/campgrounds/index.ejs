<% layout("layout/boilerplate.ejs") %>

<div id="cluster-map"></div>

<h1>All Campgrounds</h1>
<div class="mb-3">
  <a href="/campgrounds/new" class="btn btn-success"><i class="fa-solid fa-plus"></i> Add Campground</a>
</div>
<div>
  <% for (let campground of campgrounds) { %>
  <div class="card mb-3">
    <div class="row">
      <div class="col-md-4">
        <% if (campground.images.length) { %>
        <img class="img-fluid" src="<%= campground.images[0].url %>" alt="<%= campground.title %>" />
        <% } else { %>
        <img class="img-fluid" src="https://res.cloudinary.com/developer-indra/image/upload/v1745081276/YelpCamp/fewz4gqquelqigxxnysp.jpg" alt="Default Image" />
        <% } %>
      </div>
      <div class="col-md-8">
        <div class="card-body">
          <h5 class="card-title"><%= campground.title %></h5>
          <p class="card-text"><%= campground.description %></p>
          <p class="card-text">
            <small class="text-secondary"><%= campground.location %></small>
          </p>
          <a href="/campgrounds/<%= campground._id %>" class="btn btn-primary">View <%= campground.title %>
            <i class="fa-solid fa-arrow-right ms-1"></i>
          </a>
        </div>
      </div>
    </div>
  </div>
  <% } %>
</div>

<script>
  const mapboxToken = "<%- process.env.MAPBOX_TOKEN %>";
  const campgrounds = {
    features: <%- JSON.stringify(campgrounds) %>
  };
</script>

<script src="/js/clusterMap.js"></script>